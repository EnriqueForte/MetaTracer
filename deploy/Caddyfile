# MetaTracer - same-origin entrypoint (T10, cut over in T11)
# ---------------------------------------------------------------------------
# One origin is a hard requirement: the session cookie is SameSite=Lax and the
# CSP is `connect-src 'self'`. Caddy routes by path and never inspects bodies.
#
# Web V2 (Next.js) is the product frontend and owns the origin root. FastAPI is
# still the single authority for data and safety; it is reachable only under
# /api and serves no HTML pages any more.
#
#   /api/*     -> web     (JSON API + SSE)
#   /static/*  -> web     (legacy asset path, answers 404 after T11)
#   /*         -> web-v2  (Next.js UI)

:8080 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy web:8000 {
			flush_interval -1
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /static/* {
		reverse_proxy web:8000 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		reverse_proxy web-v2:3000 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	header -Server

	log {
		output stdout
		format console
	}
}