# MetaTracer configuration — copy to `.env` and adjust.
# NEVER put real secret values in this file; it is documentation of variable names only.

# Async SQLAlchemy database URL. Two supported backends (TASK-23, Eje B):
#   SQLite (default):    sqlite+aiosqlite:///./data/metatracer.db
#   PostgreSQL+asyncpg:  postgresql+asyncpg://user:password@host:5432/metatracer
# The PostgreSQL backend must use the asyncpg driver (a bare postgresql:// URL
# is rejected at startup). Schema on PostgreSQL is managed by Alembic
# migrations; SQLite keeps the legacy additive bootstrap. Requires the
# pgvector extension on the server (installed automatically when available).
METATRACER_DATABASE_URL=sqlite+aiosqlite:///./data/metatracer.db

# LLM provider (Kimi / Moonshot, OpenAI-compatible API). Empty until the agent slice.
METATRACER_LLM_API_KEY=
METATRACER_LLM_BASE_URL=
METATRACER_LLM_MODEL=
METATRACER_FAST_MODEL=

# Logging level (DEBUG, INFO, WARNING, ERROR).
METATRACER_LOG_LEVEL=INFO

# Download limits per run. The agent budget is separate: a run can download
# more assets than it sends to the model. This is also the default value of
# the crawl budget's asset cap; a scan may override the whole budget per
# request. Values above the ceiling (500) are clamped, not rejected.
METATRACER_MAX_ASSETS_PER_RUN=50
METATRACER_MAX_AGENT_FINDINGS=50
METATRACER_LLM_CONCURRENCY=1
METATRACER_MAX_FILE_BYTES=52428800

# Requests per second allowed per domain.
METATRACER_RATE_LIMIT_RPS=2

# API-edge rate limit (requests per minute per client IP). Local API bound to
# 127.0.0.1; the Docker image binds 0.0.0.0, so this guards the exposed API.
# 0 disables the guard (e.g. behind a reverse proxy that already limits).
# NOTE: if you put a reverse proxy in front, it MUST sanitize the
# X-Forwarded-For header; the limiter keys by peer + leftmost forwarded IP,
# so a proxy passing client-supplied XFF would let a caller rotate identities.
METATRACER_API_RATE_LIMIT_PER_MINUTE=120

# Maximum request body accepted by the API (bytes). Applies to the import
# endpoints and any future raw-body consumer; 5 MiB for operational JSON.
METATRACER_MAX_REQUEST_BODY_BYTES=5242880

# Maximum scans running at the same time in this process (TASK-23, Eje B).
# 1 keeps the historical single-scan behavior (a second request gets 409);
# >1 allows parallel scans (recommended only with the PostgreSQL backend).
# NOTE: the per-domain rate limit (METATRACER_RATE_LIMIT_RPS) is applied per
# run, so N concurrent runs multiply the effective RPS against the same
# domain — the LLM and target load remain the real bottleneck resources.
METATRACER_MAX_CONCURRENT_RUNS=1

# Authentication for the Web UI / API (TASK-24 / clone first-run).
# true: /login, then /setup for the first operator (token in the API log).
# The Python Settings default is still false so pytest and a bare
# `metatracer serve` without this file stay usable without login.
# A non-loopback bind (0.0.0.0, Docker) REFUSES to start while this is
# false (TASK-27). The localhost CLI needs no login either way.
# When true: data endpoints require a session and mutations also require
# the CSRF header the UI sends.
METATRACER_AUTH_ENABLED=true
# Explicit opt-in for a public bind with auth disabled. Logged as WARNING on
# every start. Does NOT disable scope checks or the network safety guard.
METATRACER_ALLOW_UNAUTHENTICATED_BIND=false
# Initial operator password — OPTIONAL since TASK-25. When set (and the user
# table is empty), the operator is provisioned automatically on first boot
# (min 8 chars; stored as a PBKDF2 hash, never logged). When EMPTY with auth
# ON, the app starts in SETUP MODE: a one-shot setup token is printed once
# to the console and the first account is created at /setup (first-run UI).
# NEVER commit a real value; use your secret manager.
METATRACER_AUTH_PASSWORD=
# Session lifetime in seconds (default 12h). Sessions rotate on every login.
METATRACER_SESSION_TTL_SECONDS=43200
# Default invitation TTL in seconds (TASK-25; default 7 days). Operators can
# override the TTL per invitation (60 s .. 30 days max) from the admin panel.
METATRACER_INVITE_TTL_SECONDS=604800

# Delete terminal runs older than this many days (TASK-30). Leave unset to
# keep every run. Pending and running scans are never deleted. Watch deltas
# use the runs that remain, so pruning a baseline can make a later watch
# report those findings as new. The API sweeps at startup and every 24h;
# `metatracer runs prune` does the same pass.
# METATRACER_RETENTION_DAYS=

# TEST ONLY. Outside pytest, serve/scan/watch refuse to start when this is
# true (PYTEST_CURRENT_TEST is the marker). Loopback stays blocked otherwise.
METATRACER_ALLOW_LOOPBACK=false

# Local MiniLM ONNX (TASK-40). Empty keeps hashing-trick embeddings.
# Paths must be local files already on disk — MetaTracer does not download
# weights. Optional extra: pip install "metatracer[onnx]".
# METATRACER_ONNX_MODEL_PATH=
# METATRACER_ONNX_TOKENIZER_PATH=

# Local API bind host. Docker deployments will use 0.0.0.0.
METATRACER_BIND_HOST=127.0.0.1
